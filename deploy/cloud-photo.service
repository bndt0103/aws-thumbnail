[Unit]
Description=Cloud Photo teaching gallery
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/cloud-photo/web
EnvironmentFile=/home/ec2-user/cloud-photo/.env
ExecStart=/home/ec2-user/cloud-photo/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --timeout 90 --access-logfile - --error-logfile - app:create_app()
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
